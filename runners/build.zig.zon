.{
    .name = .geode_test_harness_runners,
    .version = "0.1.0",
    .fingerprint = 0xb078359f271b0034,
    .minimum_zig_version = "0.15.1",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "zig_runner_new.zig",
    },
    .dependencies = .{
        // Geode client library from sibling directory (geode-test-harness/../geode-client-zig)
        .geode_client = .{
            .path = "../../geode-client-zig",
        },
        // YAML library for parsing test specs
        // NOTE: This path assumes the zig-yaml library is cloned to a sibling directory.
        // Clone from: https://github.com/zig-pkg/yaml (or your organization's fork)
        // Expected location: ../../../../zig/yaml relative to runners/
        // Alternative: vendor the library into this repository
        .yaml = .{
            .path = "../../../../zig/yaml",
        },
    },
}
